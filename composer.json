{
    "name": "mifefr/consent-string-sdk-php",
    "description": "IAB Europe Transparency and Consent Framework (TCF) v2.3 and v1.1 consent string decoder and encoder for PHP",
    "type": "library",
    "keywords": ["tcf", "tcf-v2", "tcstring", "iab", "iabtcf", "consent", "consent-string", "gdpr", "rgpd", "cmp", "cookie", "privacy"],
    "license": "MIT",
    "authors": [
        {
            "name": "Allan BRUYERE",
            "role": "Developer"
        },
        {
            "name": "Geoffray VEYSSIÉ",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4" : {
            "Mifefr\\ConsentString\\" : "src"
        },
        "files": [
              "src/functions.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33"
    },
    "require": {
        "php": ">=5.6.0"
    }
}
